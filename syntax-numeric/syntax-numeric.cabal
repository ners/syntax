cabal-version:       3.0
name:                syntax-numeric
version:             1.0.0.0
synopsis:            Numeric combinators.
license:             Apache-2.0
license-file:        LICENCE.md
author:              ners
maintainer:          ners <ners@gmx.ch>
copyright:           ners 2026
category:            Data
build-type:          Simple

source-repository head
  type:     git
  location: https://github.com/ners/syntax

library
  exposed-modules:     Data.Syntax.Numeric
  build-depends:       base >= 4 && < 5, syntax >= 1, semi-iso >= 1, scientific, mono-traversable
  default-language:    Haskell2010
  ghc-options: -Wall
